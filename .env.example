# Copy to backend/.env and fill in. Never commit real credentials.

# Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Integration mode: auto | simulated | live
#   auto       live when usable credentials are present, otherwise simulated
#   simulated  no network calls; responses are labelled _simulated: true
#   live       real calls to api.razorpay.com
RAZORPAY_MODE=auto

# LLM Provider: none | openrouter
# 'none' keeps the deterministic template path (no model calls).
# The model reads and writes free text only; it never makes the contest decision.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Pick a slug with: python scripts/test_llm_key.py --all
LLM_MODEL=
